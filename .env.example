PORT=3000
# Пароль для панели клиники (/#admin). Обязательно смените перед показом.
ADMIN_PASSWORD=denova
# Код из «SMS» для входа в кабинет пациента (в демо SMS не отправляются)
DEMO_SMS_CODE=1234
# Секрет для подписи сессий; если не задан — генерируется в data/secret
SESSION_SECRET=
# Где хранить базу и загруженные файлы
DATA_DIR=./data
